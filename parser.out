Rule 34    expressao -> FALSE
Rule 35    expressao -> ID LPAREN expressao RPAREN
Rule 36    expressao -> ID
Rule 37    tipo -> T_INT
Rule 38    tipo -> T_BOOL
Rule 39    expressao -> SUBTRACTION expressao

